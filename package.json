{
  "name": "codex-workspace",
  "version": "0.3.0",
  "description": "Codex CLI conversation panel for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "install:local": "npm run build && node scripts/install-local.mjs"
  },
  "keywords": [
    "obsidian",
    "codex",
    "chatgpt"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "obsidian": "latest",
    "typescript": "^5.7.2"
  }
}
